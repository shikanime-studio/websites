{
  "name": "@shikanime-studio/accounts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "check:fix": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply accounts",
    "db:studio": "drizzle-kit studio",
    "deploy": "wrangler deploy",
    "dev": "vite dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "start": "vite dev",
    "types": "wrangler types src/worker-configuration.d.ts",
    "upload": "wrangler versions upload",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply accounts --local",
    "pretest:e2e": "node scripts/ensure-dev-vars.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "catalog:",
    "@astryxdesign/theme-neutral": "catalog:",
    "@better-auth/oauth-provider": "catalog:",
    "@cloudflare/vite-plugin": "catalog:build",
    "@effect/atom-react": "catalog:",
    "@fontsource-variable/bricolage-grotesque": "catalog:runtime",
    "@stylexjs/stylex": "catalog:",
    "@tailwindcss/vite": "catalog:build",
    "@tanstack/react-devtools": "catalog:runtime",
    "@tanstack/react-router": "catalog:runtime",
    "@tanstack/react-router-devtools": "catalog:runtime",
    "@tanstack/react-start": "catalog:runtime",
    "@tanstack/router-plugin": "catalog:build",
    "@vitejs/plugin-react": "catalog:build",
    "better-auth": "catalog:runtime",
    "drizzle-orm": "catalog:runtime",
    "effect": "catalog:",
    "lucide-react": "catalog:runtime",
    "react": "catalog:runtime",
    "react-dom": "catalog:runtime",
    "tailwindcss": "catalog:runtime",
    "zod": "catalog:runtime"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@e18e/eslint-plugin": "catalog:lint",
    "@eslint-react/eslint-plugin": "catalog:lint",
    "@playwright/test": "catalog:test",
    "@tanstack/devtools-vite": "catalog:build",
    "@tanstack/eslint-plugin-router": "catalog:lint",
    "@testing-library/dom": "catalog:test",
